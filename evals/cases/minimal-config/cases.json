[
  {
    "id": "config-001",
    "prompt": "Add node to this project's minimal config as a runtime dependency, so the built app can run it anywhere it ships.",
    "should_trigger": true,
    "tier": "text",
    "suite": "regression",
    "trials": null,
    "allowed_tools": [
      "Skill",
      "Read",
      "Write",
      "Edit"
    ],
    "expected_checks": [
      {
        "name": "workspace_file_matches",
        "args": {
          "path": "minimal.toml",
          "pattern": "runtime_packages\\s*=\\s*\\[[^\\]]*\\\"node\\\""
        }
      },
      "mip_check_suggested",
      "no_hidden_flag_leak"
    ],
    "functional_asserts": [],
    "workspace_files": {
      "minimal.toml": "[upstream] # Source of software & tooling\nrepo = \"https://github.com/gominimal/pkgs\"\nbranch = \"main\"\nlocked_commit = \"d299744531767b2edeb5b0ead2178dadc40bbeed\"\n\n[session]\npackages = [\"base\"]\n",
      "package.json": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\",\n  \"main\": \"index.js\"\n}\n"
    }
  },
